# ============================================================================
# Snowflake 실시간 동기화용 환경변수 (Vercel 프로젝트 Settings → Environment Variables)
# 아직 값이 없으면 비워두세요 — 비어있으면 앱은 기존처럼 data/raw_query.csv를 사용합니다.
# ============================================================================

# 개발자에게 요청할 것: 대시보드 전용 서비스 계정 (key-pair 인증, 아래 8개 테이블 SELECT 권한만)
# counsel_application / counsel_vehicle / counsel_status_log / customer / users / manager / gift / common_code
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
# PEM 개인키 전체 내용. 개행은 \n 문자로 이스케이프해서 한 줄로 저장 (예: -----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n)
SNOWFLAKE_PRIVATE_KEY=
# 개인키에 암호를 걸었다면 그 암호 (안 걸었으면 비워둠)
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=AJDCAR_PROD
SNOWFLAKE_SCHEMA=PUBLIC

# Vercel 프로젝트에 Blob 스토어를 연결하면 자동으로 채워집니다 (Storage 탭 → Create → Blob).
# 동기화한 CSV를 여기에 저장해뒀다가 페이지가 다시 빌드될 때 읽어옵니다.
BLOB_READ_WRITE_TOKEN=

# /api/cron/sync 를 외부에서 함부로 못 부르게 막는 임의 문자열.
# Vercel Cron Job이 설정되면 요청 시 Authorization: Bearer <CRON_SECRET> 헤더를 자동으로 실어 보냅니다.
CRON_SECRET=

# ============================================================================
# 웹페이지에서 CSV 업로드 기능 (관리자만, "내 권한" 토글이 관리자일 때 노출)
# ============================================================================

# 이것도 없으면 업로드 API가 아예 막혀 있습니다(503). 직접 정한 임의 비밀번호를
# 넣어두고, 대시보드 업로드 패널에서 같은 값을 입력해야 반영됩니다.
# BLOB_READ_WRITE_TOKEN도 같이 있어야 실제로 저장됩니다(위 참고).
UPLOAD_SECRET=
